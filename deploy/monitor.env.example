# Copy to /etc/chessbot/monitor.env and `chmod 600` it — it holds the bot's API token.

# The bot's Lichess username (required).
LICHESS_BOT=tward-bot

# The bot's API token (the same one lichess-bot uses). Optional, but without it the
# dashboard can't show live games (it reads /api/account/playing). Never served by the monitor.
LICHESS_TOKEN=

# Dashboard / JSON API. Keep it on the LAN; reach it remotely through HA or Tailscale.
MONITOR_HOST=0.0.0.0
MONITOR_PORT=8090

# Seconds between polls: live games while playing / while idle, and profile + recent games.
LIVE_POLL_SECONDS=5
IDLE_POLL_SECONDS=15
PROFILE_POLL_SECONDS=60

# Substring of the lichess-bot process's command line; "none" disables the check.
PROCESS_PATTERN=lichess-bot.py

# Home Assistant MQTT discovery. Leave MQTT_URL empty to disable.
MQTT_URL=tcp://homeassistant.local:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# MQTT_TOPIC=chessbot/tward-bot
# MQTT_DISCOVERY_PREFIX=homeassistant

# Day boundary for "today" stats.
TZ=Europe/London
