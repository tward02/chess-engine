# Copy to deploy.env (git-ignored) and fill in. Used by deploy-engine.ps1.

# SSH login on the chessbot VM
VM_USER=chessbot
# Hosts tried in order: LAN first, then Tailscale for when you're away from home
VM_HOSTS=192.168.50.5,100.113.229.8
SSH_PORT=22
# Private key to log in with. Leave empty to log in with VM_USER's password: ssh asks for it twice
# per deploy (upload, then install), plus once more for sudo if ENGINE_DIR isn't writable by VM_USER.
# The password is never stored here.
SSH_KEY=

# Where lichess-bot looks for the engine (engine.dir / engine.name in config.yml)
ENGINE_DIR=/opt/chessbot/lichess-bot/engines
ENGINE_NAME=uci-engine.jar
# Timestamped backups of replaced jars kept on the VM
KEEP_BACKUPS=5
